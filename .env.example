# Copy to .env and fill in. The secret gist that holds the per-video TOC markdown files.
# In CI, provide these as repository variables/secrets instead.
TOC_GIST_USER=your-github-username
TOC_GIST_ID=0123456789abcdef0123456789abcdef
# Hostname(s) of the course site the bookmarklet is allowed to run on (comma-separated).
TOC_ALLOWED_HOSTS=courses.example.com
# Only needed for `npm run deploy` (publishing the install page).
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000
INSTALL_PAGE_URL=https://your-site.netlify.app
